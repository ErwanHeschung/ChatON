# Copy to .env, then: docker compose up -d
# The instance's domain, its DNS pointing at this machine (ports 80 and 443 open).
DOMAIN=chaton.example.org
# Shown next to the domain in clients (optional).
SERVER_NAME=
# Where the instance is, ISO codes (FR, or FR,BE): its place on the network map (optional).
SERVER_COUNTRY=

# Voice: set a secret (openssl rand -hex 32), start with docker compose --profile voice up -d,
# open ports 7881/tcp and 7882/udp. Empty: no voice.
LIVEKIT_SECRET=

# Pin a version instead of following latest (optional).
# CHATON_VERSION=0.1.0
